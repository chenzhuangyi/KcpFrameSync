# udp端口（服务器绑定端口；客户端也以此为默认目标端口）
udp_port = "10500"

# ---- 服务器多玩家房间参数 ----
# 设定的最大玩家数（不超过 8）：初始玩家列表（player_ids）人数不得超过它，
# 也是客户端 JOIN 的满员上限（初始占位 + 在线 + 转房遗留均计入）
max_player = 4
# 输入帧收集超时阈值（毫秒）：超过后未集齐用最近完整帧输入填充并强制广播
timeout_ms = 500

# 会话鉴权 token：客户端 join(room_id, token) 须携带相同值；0=不校验
token = 0
# 房间最长保留时间（毫秒）：超过后自动销毁房间做冗余清理；0=永久
ttl_ms = 0
# 玩家掉线判定阈值（毫秒）：在线玩家超过未活跃（心跳/输入）标记掉线
# （席位保留、可重连，不自动删除成员；业务层可调 remove_player 主动清理）。
# 准备阶段（等全员就绪、房间未 start、尚无帧包）玩家连接全靠心跳保活，
# 该值须配合 heartbeat_ms 设置：如心跳 500ms、阈值 2000ms（连丢 4 个心跳判掉线）。
idle_timeout_ms = 2000

# 帧率（每秒帧数）
frame_rate = 1
# 输入提前量窗口（帧）：客户端把输入补发到"当前帧+advance_frames"，
# 服务器从玩家超前缓冲按帧号取全员输入推进（标准帧同步输入窗口，须 < 服务器缓冲 8）
advance_frames = 2


# ---- 自测用的房间参数 ----
# 测试运行时长（毫秒）
duration_ms = 5000
clinten_duration_ms = 2000


# ---- 客户端批量测试参数（client.lua 使用） ----
# 服务器地址（客户端连接目标）
server_ip = "127.0.0.1"
# 目标服务器端口（默认取 udp_port）
# server_port = "10500"
# 并发客户端数量
client_count = 2
# 客户端自动心跳间隔（毫秒）：走 KCP 可靠传输补发 HEARTBEAT，供服务器
# 基于 last_active 做掉线判定（须与服务器 idle_timeout_ms 配合）；0=关闭。
# 准备阶段（房间未 start、尚无帧包）玩家连接全靠心跳保活，必须开启。
heartbeat_ms = 500
# 客户端不绑定固定端口：客户端库 new(0, conv) 由系统分配端口，
# 再经 join() 发裸 UDP JOIN，服务器从包源地址自动学地址并登记进房间。
# （无需 client_base_port，已删除）
# 起始 conv；每个客户端 conv = conv + (i-1)
conv = 1
